# Base domain: admin panel at https://t.example.com, tunnels at https://<sub>.t.example.com
TAMSYAM_DOMAIN=t.example.com
# Admin panel password (HTTP Basic, any username)
TAMSYAM_ADMIN_PASSWORD=change-me
# Where Caddy reaches the server. Use 0.0.0.0:8090 if Caddy runs on another host.
TAMSYAM_LISTEN=0.0.0.0:8090
TAMSYAM_DB=/var/lib/tamsyam/tamsyam.db
TAMSYAM_PUBLIC_SCHEME=https
# TCP tunnels (ts tcp): public port range, forwarded on your router straight to this
# server (not through Caddy). Leave empty to disable TCP tunnels.
TAMSYAM_TCP_PORTS=20000-20099
# Host shown in tcp:// addresses (defaults to TAMSYAM_DOMAIN)
#TAMSYAM_TCP_HOST=t.example.com
