# Base domain: admin panel at https://<domain>, tunnels at https://<sub>.<domain>.
# Cloudflare DNS needs A records for <domain> and *.<domain> (DNS only, grey cloud).
TAMSYAM_DOMAIN=t.example.com
# Admin panel password (HTTP Basic, any username). Generate: openssl rand -base64 24
TAMSYAM_ADMIN_PASSWORD=
# Cloudflare API token with Zone:DNS:Edit on the zone (wildcard certificate).
CF_API_TOKEN=
# Public port range for TCP tunnels (ts tcp). Forward it on your router.
TAMSYAM_TCP_PORTS=20000-20019
# Optional: LAN CIDRs where the admin panel opens without the password.
TAMSYAM_PRIVATE_NETWORKS=
# Image tag; pin a release (e.g. 0.3.0) for reproducible upgrades.
TAMSYAM_VERSION=latest
